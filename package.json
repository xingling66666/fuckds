{
  "name": "fuckds",
  "version": "0.1.0",
  "description": "把 chat.deepseek.com 网页对话包装成 OpenAI 兼容 API：Playwright 驱动浏览器，每条消息都是一次全新对话，上下文由 ## ROLE 段落拼接。",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "dev": "node --watch src/index.mjs",
    "auth": "node scripts/auth.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test --test-concurrency=1 'test/**/*.test.mjs'",
    "setup:deps": "bash scripts/install-chromium-deps.sh",
    "setup:browser": "playwright install chromium",
    "up": "node scripts/server-ctl.mjs up",
    "down": "node scripts/server-ctl.mjs down",
    "restart": "node scripts/server-ctl.mjs restart",
    "status": "node scripts/server-ctl.mjs status",
    "pow:build": "node scripts/build-pow.mjs",
    "package": "node scripts/package.mjs",
    "admin:install": "npm --prefix web install",
    "admin:build": "npm --prefix web run build",
    "admin:dev": "npm --prefix web run dev"
  },
  "dependencies": {
    "playwright": "^1.55.1"
  }
}
