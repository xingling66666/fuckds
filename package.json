{
  "name": "fuckds",
  "version": "0.1.0",
  "description": "把 chat.deepseek.com 网页对话包装成 OpenAI 兼容 API：Playwright 驱动浏览器，每条消息都是一次全新对话，上下文由 ## ROLE 段落拼接。",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.4.0"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "dev": "node --watch src/index.mjs",
    "auth": "node scripts/auth.mjs",
    "pow:build": "node scripts/build-pow.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test --test-concurrency=1 'test/**/*.test.mjs'",
    "setup:deps": "bash scripts/install-chromium-deps.sh",
    "up": "node scripts/server-ctl.mjs up",
    "down": "node scripts/server-ctl.mjs down",
    "restart": "node scripts/server-ctl.mjs restart",
    "status": "node scripts/server-ctl.mjs status",
    "package": "node scripts/package.mjs",
    "admin:install": "npm --prefix web install",
    "admin:build": "npm --prefix web run build",
    "admin:dev": "npm --prefix web run dev",
    "doctor": "node scripts/doctor.mjs",
    "diff:capture": "node scripts/diff-capture.mjs",
    "login": "node scripts/auth.mjs",
    "build:binary": "node scripts/embed-web.mjs && bun build --compile --external playwright --external playwright-core src/index.mjs --outfile bin/fuckds",
    "build:all": "npm --prefix web run build && node scripts/embed-web.mjs && bun build --compile --external playwright --external playwright-core src/index.mjs --outfile bin/fuckds",
    "embed:web": "node scripts/embed-web.mjs"
  },
  "dependencies": {
    "imapflow": "^2.11.0",
    "nodemailer": "^10.5.0",
    "playwright": "^1.49.1"
  }
}
