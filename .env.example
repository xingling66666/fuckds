# ---------------------------------------------------------------------------
# 注意：配置已改为 SQLite 持久化（data/config.db），并支持后台保存即时生效。
# 本文件只作为默认值说明 / 老 .env 的迁移来源：首次启动、库里还没有任何配置时，
# 如果项目根目录存在 .env，会把它迁移进 SQLite 一次，之后不再读写 .env。
# 日常改配置请用网页控制台 /admin 的「设置」页（保存即生效，无需重启）。
# ---------------------------------------------------------------------------

# DeepSeek 网页登录态。推荐用 `npm run auth -- <userToken>` 写入 data/auth.json，
# 而不是把 token 放在这里。
# 号池：多个 token 用空格/逗号分隔（推荐写进 data/auth.json：npm run auth -- t1 t2）
# DEEPSEEK_USER_TOKENS=
# DEEPSEEK_USER_TOKEN=
# Go PoW 求解器
# PoW 并行度：默认 = CPU 核数；压测时可设 1 对比单核性能
# 设为任意值可关掉 ARMv8.2 SHA3 汇编 Keccak，回退纯 Go（正常情况下不需要）
DEEPSEEK_BASE_URL=https://chat.deepseek.com

# 原生「深度思考」：always（默认，强制开）| never（关）| auto（按模型别名）
# DEEPSEEK_THINKING=always
# 智能搜索：默认关闭
DEEPSEEK_SEARCH=false
# 是否主动把网页上的「深度思考 / 智能搜索」开关拨到请求要求的状态
DEEPSEEK_MANAGE_TOGGLES=true
DEFAULT_MODEL=deepseek-flash

# ---------------------- 浏览器特征 ----------------------
# 设备画像：chrome-win（桌面 Chrome）| chrome-android（移动 Chrome）
# 选定后请长期固定，不要来回切换，否则请求中的 UA / 平台会在不同时间跳变
DEEPSEEK_DEVICE_PROFILE=chrome-win
# 冷启动序列：启动时先拉配置、校验设备、回执配置，让账号有「网页打开过」的痕迹
DEEPSEEK_COLD_START=true
# 行为时序：把 PoW 求解耗时补到接近真浏览器 JS 的水平，并在发送前加随机停顿
DEEPSEEK_HUMAN_TIMING=true

# ---------------------------- 引擎 ----------------------------
# hybrid（默认）：登录走真浏览器，转发走逆向接口（需要 bin/ds-pow，见 npm run pow:build）
# browser       ：全部走 Playwright（旧行为，出问题时的回退开关）
# direct        ：全部走直连，连登录辅助都不用（token 需要外部喂进来）
DS_ENGINE=hybrid
# PoW 求解器路径（相对仓库根目录）
DS_POW_BIN=bin/ds-pow

# ---------------------------- 正文通道 ----------------------------
# 正文整包作为 .txt 附件上传，输入框只放一句引导（默认关：直接填输入框）
# 需要"输入框只留一句引导"时再打开
PROMPT_AS_ATTACHMENT=false

# ---------------------------- 服务 ----------------------------
HOST=127.0.0.1
PORT=8787
# 设置后，客户端必须带 Authorization: Bearer <API_KEY>
API_KEY=
CORS_ORIGIN=*
LOG_LEVEL=info

# ---------------------------- 浏览器 ----------------------------
BROWSER_HEADLESS=true
# BROWSER_USER_AGENT=...
# CHROMIUM_EXECUTABLE=/path/to/chrome
# 无 root 环境下解包出来的依赖库目录
CHROMIUM_DEPS_DIR=~/.local/chromium-deps
BROWSER_WIDTH=1440
BROWSER_HEIGHT=900
BROWSER_LOCALE=zh-CN

# ---------------------------- 运行 ----------------------------
# 同时跑几个浏览器页面（每个请求占一个页面，手机/小内存建议 1）
CONCURRENCY=1
QUEUE_LIMIT=64
REQUEST_TIMEOUT_MS=240000
FIRST_TOKEN_TIMEOUT_MS=90000
POLL_INTERVAL_MS=60
SETTLE_MS=800
# 两次发送的最小间隔与触发「发送过于频繁」后的退避
SEND_INTERVAL_MS=4000
# 某个账号被限流后的冷却时间，以及请求最多愿意等多久（超过就返回 429）
ACCOUNT_COOLDOWN_MS=60000
MAX_COOLDOWN_WAIT_MS=5000
REASONING_HOLD_MS=900
RATE_LIMIT_BACKOFF_MS=4000
# 空闲多久关闭浏览器释放内存（0 = 不关闭）
IDLE_SHUTDOWN_MS=900000
# 启动时预热浏览器（省掉第一次请求的 2~3 秒）
WARMUP=true
# 浏览器模式：抓页面自己发出的补全接口原始流，用模型原始输出（含工具调用 token）当权威文本，
# DOM 只负责流式展示。关掉退回纯 DOM 提取（偶发丢工具调用的风险变高）。
BROWSER_CAPTURE=true
# DOM 提前判定结束时，最多再等原始流收尾多久（毫秒），用来补齐被截断的尾部 token
BROWSER_CAPTURE_WAIT_MS=20000
# 模型自己编造工具结果（RESULT）时，非流式请求带着更硬的约束重试一次
# 检测到模型自己写 RESULT / 伪造段落标题时，立即中止生成并先返回已拿到的正文和工具调用
# （模型编造结果后会继续长篇续写，不早停会让请求一直卡到超时）
# 网页输入框单次上限；超过就把较早的对话拆成 .txt 附件（ref_file_ids）注入
MAX_PROMPT_CHARS=100000
# 拆到附件的上下文最多多少字符
MAX_ATTACHMENT_CHARS=2000000
# 关掉则恢复旧行为：超长直接返回 413
OVERFLOW_TO_ATTACHMENT=true
SAVE_ARTIFACTS=true

# ======================= 防封（2026-11 逆向自网页端风控） =======================
# 出口代理：按账号下标粘性绑定（#1→第1个，#2→第2个…）。
# 服务端按 IP 算风控（40029 IP_ACCESS_RESTRICTED），**同 IP 多号是最重的信号**。
# 生产环境请保证「代理数 >= 账号数」。支持 http:// / https:// / socks5://，可带 user:pass@。
# 示例：DEEPSEEK_PROXIES=http://u:p@1.2.3.4:8080,socks5://5.6.7.8:1080
DEEPSEEK_PROXIES=

# 真网页当前的客户端版本与语言（会写进 x-client-version / x-client-locale）
DEEPSEEK_CLIENT_VERSION=2.7.1
DEEPSEEK_LOCALE=zh_CN
# 冷启动补跑周期（毫秒，0=只在首次跑）：定期补 /client/settings/report，避免设备画像「只活跃过一次」
DEEPSEEK_COLDSTART_REFRESH_MS=1800000
# 会话复用：0=每条消息新建会话（会话:消息=1:1，机器人指纹强）
#           >0=同一 chat_session 最多发 N 条根消息再换新的（把比例拉向人类，推荐 3~5）
DEEPSEEK_SESSION_REUSE=0

# 拟人节奏：同账号两次请求的最小间隔 + 抖动（毫秒）
# 每 N 次请求插一次分钟级长休（0=关闭；自用嫌慢就留 0，挂机跑推荐 10~15）
# 只在活跃时段内发请求，形如 09:00-23:30（空=全天）
# 一次请求内最多换几个账号（换号太勤 = 多号同时被标记）
MAX_ACCOUNT_SWITCHES=1

# ============== 像人：会话续聊 / 请求形态（2026-11 吊销复盘后新增） ==============
# 一个会话里最多连发几轮（续聊）。真人一个对话聊很多条；旧行为「每条消息都新开会话」= 机器人指纹。
# 续聊时只发新增消息，parent_message_id 指向上一轮回复。设 0 = 退回旧行为（不建议）。
DEEPSEEK_SESSION_REUSE=8

# 单次 prompt 上限（字符）。线上被吊销的请求都在 14~47 万字符，默认从 165 万降到 12 万。
MAX_PROMPT_CHARS=120000
# 工具数超过它就强制压缩声明（一行一个工具，体积约 1/10）。日志里出现过 324 个工具。
TOOL_DECL_COMPACT_THRESHOLD=40
# 单次 prompt 超过这个字符数就告警（会写进日志，提醒你正在高危形态里）
BIG_PROMPT_CHARS=80000
# 滚动 1 小时内累计 prompt 字符上限，超了就强制长休
WINDOW_CHARS_LIMIT=1500000
USAGE_THROTTLE_MS=120000

# 冷启动是否调用 /users/auth_token/check_device（危险动作，默认关闭）。
# 设备与 token 不匹配时，这个调用会主动告诉服务端「陌生设备在用你的 token」→ token 被吊销。
DEEPSEEK_COLDSTART_DECLARE_DEVICE=false




# ── 自动登录（浏览器） ─────────────────────────────────────────────
# 账号密码：后台「自动登录」按钮和 npm run auth 都会用
DS_EMAIL=
DS_PASSWORD=

# 邮箱验证码（MFA）：收信用 IMAP，Gmail 必须用「应用专用密码」
MAIL_USER=
MAIL_PASS=
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=465
MAIL_FROM=
MAIL_CODE_TIMEOUT_MS=120000

# ---------- 邮箱 IMAP 认证（收验证码） ----------
# password：应用密码 / 授权码（Gmail 等；微软个人账户已废弃）
# oauth   ：XOAUTH2（微软个人账户必须用这个）
MAIL_AUTH_MODE=password
# Azure 应用（免费注册）：账户类型选「个人 Microsoft 账户」，打开「允许公共客户端流」
MAIL_OAUTH_CLIENT_ID=
MAIL_OAUTH_TENANT=consumers
# 在后台点「开始 OAuth 授权」后自动写入，一般不用手填
MAIL_OAUTH_REFRESH_TOKEN=
MAIL_OAUTH_SCOPE=https://outlook.office.com/IMAP.AccessAsUser.All offline_access
PROTOCOL_MODE=nudge
